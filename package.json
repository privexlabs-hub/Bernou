{
  "name": "bernou",
  "version": "0.1.0",
  "private": true,
  "description": "Bernou — private presentation, teleprompter, recording and live meeting studio",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @bernou/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @bernou/web test:e2e",
    "lint": "pnpm -r lint",
    "boundary": "depcruise --config .dependency-cruiser.cjs packages apps/web/src",
    "boundary:meta": "node scripts/boundary-meta-test.mjs",
    "check": "pnpm typecheck && pnpm boundary && pnpm boundary:meta && pnpm test && pnpm --filter @bernou/web build && pnpm privacy:bundle",
    "privacy:bundle": "node scripts/bundle-privacy-check.mjs"
  },
  "devDependencies": {
    "dependency-cruiser": "^16.10.0",
    "pdf-lib": "^1.17.1",
    "typescript": "^5.7.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@napi-rs/canvas"
    ]
  }
}
